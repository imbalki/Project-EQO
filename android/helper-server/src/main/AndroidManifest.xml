<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-007 (issue #12): manager-role manifest of the EQO privileged helper, forked from
     RikkaApps/Shizuku @ b844bc491f1790c72328e1a8e5b2349f8978f0ea (manager/src/main/AndroidManifest.xml:
     permission block + ShizukuManagerProvider declaration). Permission strings are renamed in
     lockstep with the server and client code (D-004). Upstream icon resources are not reused.
     EQO itself does NOT request the dangerous API_V23 permission (upstream manager removes it
     with tools:node="remove" for the same reason): as the allowlisted manager it holds
     ai.eqo.app.helper.permission.MANAGER instead. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission-group
        android:name="ai.eqo.app.helper.permission-group.API"
        android:description="@string/helper_permission_group_description"
        android:label="@string/helper_permission_group_label" />

    <permission
        android:name="ai.eqo.app.helper.permission.MANAGER"
        android:protectionLevel="signature" />
    <uses-permission android:name="ai.eqo.app.helper.permission.MANAGER" />

    <permission
        android:name="ai.eqo.app.helper.permission.API_V23"
        android:description="@string/helper_permission_description"
        android:label="@string/helper_permission_label"
        android:permissionGroup="ai.eqo.app.helper.permission-group.API"
        android:protectionLevel="dangerous" />

    <application>
        <provider
            android:name="moe.shizuku.manager.ShizukuManagerProvider"
            android:authorities="${applicationId}.helper"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
