<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 11+: visibility only, as required by Telephony.Sms.getDefaultSmsPackage.
         This declares no receiver and grants no inbox or send permission. -->
    <queries>
        <intent>
            <action android:name="android.provider.Telephony.SMS_DELIVER" />
        </intent>
    </queries>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:name=".EqoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/eqo_label"
        android:theme="@style/StudyTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- TASK-005: `eqo://` deep links. MainActivity resolves eqo://legal to the
                 Legal / open-source notices screen (UF-14, S-28). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eqo" android:host="legal" />
            </intent-filter>
        </activity>
        <!-- TASK-015 (issue #20): guided onboarding screens (UF-02..UF-06), the capability
             dashboard (UF-08), the study task screen (UF-09/UF-10) and the offline legal /
             open-source notices screen (UF-14). -->
        <activity
            android:name=".onboarding.SetupHubActivity"
            android:exported="false" />
        <activity
            android:name=".onboarding.ModelKeySetupActivity"
            android:exported="false" />
        <activity
            android:name=".onboarding.AccessibilitySetupActivity"
            android:exported="false" />
        <activity
            android:name=".onboarding.WirelessAdbSetupActivity"
            android:exported="false" />
        <activity
            android:name=".onboarding.ChromeConsentActivity"
            android:exported="false" />
        <activity
            android:name=".task.TaskActivity"
            android:exported="false" />
        <activity
            android:name=".legal.LegalNoticesActivity"
            android:exported="true">
            <!-- REQ-INS-03: legal notices reachable in <=3 taps and via eqo://legal. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eqo" android:host="legal" />
            </intent-filter>
        </activity>
        <!-- TASK-005: file-provider authority under the application id. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ai.eqo.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
