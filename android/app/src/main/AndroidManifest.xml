<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- TASK-069: resolve named recipients immediately before a communication step. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- TASK-069: direct MAKE_CALL only after the owner grants phone access. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- TASK-069: verify a new call entered Telecom; intent launch is not success. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Resolve only the communication app intents used by these executors. -->
    <queries>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="smsto" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="mailto" /></intent>
        <intent><action android:name="android.intent.action.DIAL" /><data android:scheme="tel" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="tg" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.telegram.plus" />
        <package android:name="nekox.messenger" />
        <package android:name="com.google.android.apps.meetings" />
        <package android:name="com.google.android.apps.tachyon" />
        <package android:name="us.zoom.videomeetings" />
    </queries>

    <!-- Android 11+: visibility only, as required by Telephony.Sms.getDefaultSmsPackage.
         This declares no receiver and grants no inbox or send permission. -->
    <queries>
        <intent>
            <action android:name="android.provider.Telephony.SMS_DELIVER" />
        </intent>
    </queries>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".EqoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/eqo_label"
        android:theme="@style/StudyTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- TASK-005: `eqo://` deep links. MainActivity resolves eqo://legal to the
                 Legal / open-source notices screen (UF-14, S-28). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eqo" android:host="legal" />
            </intent-filter>
        </activity>
        <!-- TASK-015 (issue #20): guided onboarding screens (UF-02..UF-06), the capability
             dashboard (UF-08), the study task screen (UF-09/UF-10) and the offline legal /
             open-source notices screen (UF-14). -->
        <activity
            android:name=".onboarding.SetupHubActivity"
            android:exported="false" />
        <activity
            android:name=".onboarding.ModelKeySetupActivity"
            android:exported="false" />
        <activity
            android:name=".onboarding.AccessibilitySetupActivity"
            android:exported="false" />
        <activity
            android:name=".onboarding.WirelessAdbSetupActivity"
            android:exported="false" />
        <service android:name=".onboarding.WirelessPairingService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started local wireless debugging discovery and pairing reply while Android Settings is foreground" />
        </service>
        <activity
            android:name=".onboarding.ChromeConsentActivity"
            android:exported="false" />
        <service android:name=".task.TaskRunService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-approved accessibility task execution while another app is foreground" />
        </service>
        <activity
            android:name=".task.TaskActivity"
            android:exported="false" />
        <activity
            android:name=".legal.LegalNoticesActivity"
            android:exported="true">
            <!-- REQ-INS-03: legal notices reachable in <=3 taps and via eqo://legal. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eqo" android:host="legal" />
            </intent-filter>
        </activity>
        <!-- TASK-005: file-provider authority under the application id. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ai.eqo.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
