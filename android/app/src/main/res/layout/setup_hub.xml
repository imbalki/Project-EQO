<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-015 (issue #20): capability readiness dashboard (UF-08, S-19). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/study_page_padding">

        <TextView
            style="@style/StudyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_hub_title"
            android:accessibilityHeading="true"
            android:textStyle="bold" />

        <TextView
            style="@style/StudyBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_hub_subtitle" />

        <!-- Deliberate native widget: this screen uses a platform Activity/StudyTheme,
             like EdgeHandleSettingsActivity; do not add AppCompat solely for this switch. -->
        <Switch android:id="@+id/hub_edge_handle"
            tools:ignore="UseSwitchCompatOrMaterialXml"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp" android:text="@string/hub_edge_handle"
            android:textSize="@dimen/study_text_body" />
        <TextView android:id="@+id/hub_handle_hint" style="@style/StudyBody"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/hub_handle_hint" />
        <Button android:id="@+id/hub_handle_settings" style="@style/StudySecondaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp" android:text="@string/handle_settings_title" />

        <TextView
            style="@style/StudyStatus"
            android:id="@+id/setup_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textStyle="bold" />

        <TextView
            style="@style/StudySetupRow"
            android:id="@+id/row_model_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/study_card_padding"
            android:minHeight="52dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/study_card_interactive"
            android:text="@string/setup_hub_row_model_key" />

        <TextView
            style="@style/StudySetupRow"
            android:id="@+id/row_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/study_card_padding"
            android:minHeight="52dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/study_card_interactive"
            android:text="@string/setup_hub_row_accessibility" />

        <TextView
            style="@style/StudySetupRow"
            android:id="@+id/row_wireless_adb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/study_card_padding"
            android:minHeight="52dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/study_card_interactive"
            android:text="@string/setup_hub_row_wireless_adb" />

        <TextView
            style="@style/StudySetupRow"
            android:id="@+id/row_helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/study_card_padding"
            android:minHeight="52dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/study_card_interactive"
            android:text="@string/setup_hub_row_helper" />

        <TextView
            style="@style/StudySetupRow"
            android:id="@+id/row_chrome_consent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/study_card_padding"
            android:minHeight="52dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/study_card_interactive"
            android:text="@string/setup_hub_row_chrome_consent" />

        <TextView
            style="@style/StudySetupRow"
            android:id="@+id/row_all_files"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/study_card_padding"
            android:minHeight="52dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/study_card_interactive"
            android:text="@string/setup_hub_row_all_files" />

        <Button
            style="@style/StudyButton"
            android:id="@+id/setup_recheck_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_hub_recheck"
            android:minHeight="52dp" />

        <Button
            style="@style/StudySecondaryButton"
            android:id="@+id/setup_task_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_hub_open_task"
            android:minHeight="52dp" />

        <Button
            style="@style/StudySecondaryButton"
            android:id="@+id/setup_legal_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notices_button"
            android:minHeight="52dp" />
        <Button
            style="@style/StudySecondaryButton"
            android:id="@+id/voice_engine_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/voice_engine_title" />
        <TextView
            style="@style/StudyBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_ai_disclosure" />
        <Button
            style="@style/StudySecondaryButton"
            android:id="@+id/voice_language_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/voice_language_title" />
        <CheckBox
            android:id="@+id/require_plan_approval"
            android:textSize="@dimen/study_text_body"
            android:textColor="@color/study_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/require_plan_approval" />
        <Button android:id="@+id/explain_settings" style="@style/StudySecondaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp" android:text="@string/explain_settings" />
        <Button android:id="@+id/hub_background" style="@style/StudySecondaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp" android:text="@string/hub_background" />
        <TextView style="@style/StudyBody"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/background_hints" />
    </LinearLayout>
</ScrollView>
