<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-015 (issue #20): guided wireless ADB (UF-04/UF-05, S-08..S-11). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wireless_adb_title"
            android:accessibilityHeading="true"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wireless_adb_explanation" />

        <TextView
            android:id="@+id/wireless_adb_link_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/pairing_code_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/wireless_adb_pairing_code_hint"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/pairing_port_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/wireless_adb_pairing_port_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/connection_port_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/wireless_adb_connection_port_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/wireless_adb_run_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wireless_adb_run_checks"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/wireless_adb_reconnect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wireless_adb_reconnect"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/wireless_adb_forget_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wireless_adb_forget"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/check_pair_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_not_set_up" />

        <TextView
            android:id="@+id/check_connect_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_not_set_up" />

        <TextView
            android:id="@+id/check_helper_start_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_not_set_up" />

        <TextView
            android:id="@+id/check_authorize_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_not_set_up" />

        <TextView
            android:id="@+id/check_binder_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_not_set_up" />

        <TextView
            android:id="@+id/wireless_adb_guidance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/setup_return_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/setup_return" />
    </LinearLayout>
</ScrollView>
