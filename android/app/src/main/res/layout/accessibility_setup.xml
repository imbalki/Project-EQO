<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-015 (issue #20): accessibility setup (UF-03, S-06/S-07/S-25). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_explanation" />

        <TextView
            android:id="@+id/accessibility_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/accessibility_app_settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_open_app_settings" />

        <Button
            android:id="@+id/accessibility_settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_open_settings" />

        <Button
            android:id="@+id/accessibility_recheck_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_recheck" />

        <TextView
            android:id="@+id/accessibility_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_disabled" />

        <TextView
            android:id="@+id/accessibility_guidance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_restricted_hint" />
    </LinearLayout>
</ScrollView>
