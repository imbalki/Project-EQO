<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-015 (issue #20): browser consent (UF-06, REQ-CDP-01, REQ-PRIV-03/04). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chrome_consent_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chrome_consent_what" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chrome_consent_redaction" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chrome_consent_decline_effect" />

        <Button
            android:id="@+id/chrome_consent_accept_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chrome_consent_accept" />

        <Button
            android:id="@+id/chrome_consent_decline_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chrome_consent_decline" />

        <TextView
            android:id="@+id/chrome_consent_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/chrome_consent_gate_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chrome_consent_gated_notice" />
    </LinearLayout>
</ScrollView>
