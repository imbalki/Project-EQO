<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/eqo_label" />

    <!-- TASK-008: wireless-ADB activation state (fresh install = activation required). -->
    <TextView
        android:id="@+id/activation_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/activation_required" />

    <Button
        android:id="@+id/privileged_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/privileged_action_button" />

    <Button
        android:id="@+id/notices_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/notices_button" />
</LinearLayout>
