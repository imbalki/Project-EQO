<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-015 (issue #20): legal / open-source notices screen (UF-14, REQ-INS-03). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/legal_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/legal_build_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/legal_notices_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notices_body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/legal_notice_file_hint" />

        <Button
            android:id="@+id/legal_close_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/legal_close" />
    </LinearLayout>
</ScrollView>
