<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-006 security pass F3 (issue #11): nothing is backed up below Android 12
     either. `android:allowBackup="false"` is the master switch; lint
     [DataExtractionRules] additionally requires an android:fullBackupContent
     RESOURCE (a literal "false" is not accepted) alongside
     android:dataExtractionRules at minSdk 30 / targetSdk 36 (lead's F3 spec:
     "android:fullBackupContent if lint asks").
     The root exclusion drops everything; the three explicit exclusions below
     keep the original project's rules (see the provenance map) and are
     asserted verbatim by ProviderCredentialStoreTest ("backup rules exclude
     the shared preference domain used by provider credential envelopes"). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="file" path="datastore/"/>
</full-backup-content>
