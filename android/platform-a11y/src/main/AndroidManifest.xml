<?xml version="1.0" encoding="utf-8"?>
<!--
  TASK-004: permission required by the OpenDroid code moved into
  :platform-a11y (CallFlowVerifier.kt: TelecomManager.isInCall).
  Mirrors the upstream uses-permission entry of
  yashab-cyber/opendroid @ 6ff5a061755b597b0558fed1f565587837ed4d51
  app/src/main/AndroidManifest.xml. Declared here so Android Lint can
  verify the moved code's call sites; the consuming app still decides its
  final manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
      TASK-009: exactly ONE accessibility service is registered here. Each
      upstream donor project registers its own accessibility service; EQO merges
      both donor implementations into this single service, and
      EqoSingleServiceManifestTest fails the build if a second one ever appears
      in any android/**/src/main manifest.
    -->
    <application>
        <service
            android:name="ai.eqo.accessibility.EQOAccessibilityService"
            android:description="@string/eqo_accessibility_service_description"
            android:exported="false"
            android:label="@string/eqo_accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
